---
import Base from '../../layouts/Base.astro';
import AddIdea from '../../components/AddIdea.astro';
import { currentIssues } from '../../data/issues';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Current seeds (internal)"
  description="Internal Mjidea seeds — not published blogs. Expand via execute → approve."
>
  <section class="page-intro">
    <p class="strip-label">Internal · not published</p>
    <p class="crumb"><a href={`${base}issues/`}>Seeds</a> / Current</p>
    <h1>Current seeds</h1>
    <p class="lede">
      Temp floats from the idea bank. Run <em>execute</em>, then <em>approve</em>, to replace a seed with a live blog under Blog.
    </p>
    <p class="meta"><a href={`${base}issues/future/`}>Later seeds →</a></p>
  </section>

  <ol class="issue-list">
    {
      currentIssues.map((issue, i) => (
        <li class="issue-item" id={issue.id}>
          <span class="issue-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h2>{issue.title}</h2>
            <p>{issue.summary}</p>
            <p class="meta">Angle · {issue.angle}</p>
            <p class="meta tags">{issue.tags.map((t) => <span>{t}</span>)}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <AddIdea />
</Base>
