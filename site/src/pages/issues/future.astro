---
import Base from '../../layouts/Base.astro';
import AddIdea from '../../components/AddIdea.astro';
import { futureIssues } from '../../data/issues';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Later seeds (internal)"
  description="Internal Mjidea seeds queued later — not published blogs."
>
  <section class="page-intro">
    <p class="strip-label">Internal · not published</p>
    <p class="crumb"><a href={`${base}issues/`}>Seeds</a> / Later</p>
    <h1>Later seeds</h1>
    <p class="lede">
      Themes queued behind the current float list. Steal one early via <em>execute</em>, then <em>approve</em> to publish under Blog.
    </p>
    <p class="meta"><a href={`${base}issues/current/`}>← Current seeds</a></p>
  </section>

  <ol class="issue-list">
    {
      futureIssues.map((issue, i) => (
        <li class="issue-item" id={issue.id}>
          <span class="issue-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h2>{issue.title}</h2>
            <p>{issue.summary}</p>
            <p class="meta">Angle · {issue.angle}</p>
            <p class="meta tags">{issue.tags.map((t) => <span>{t}</span>)}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <AddIdea />
</Base>
