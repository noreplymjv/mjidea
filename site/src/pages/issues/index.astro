---
import Base from '../../layouts/Base.astro';
import AddIdea from '../../components/AddIdea.astro';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Seeds (internal)"
  description="Internal Mjidea issue seeds — not published blogs. Expand via execute → approve."
>
  <section class="page-intro">
    <p class="strip-label">Internal · not published</p>
    <h1>Issue seeds</h1>
    <p class="lede">
      Temporary prompts for the war room. They are <strong>not</strong> live blogs.
      Say <em>execute</em> → review pending draft → <em>approve</em> to publish under Ideas.
    </p>
    <p class="meta">Guide: <code>HOW-IDEAS-BECOME-BLOGS.md</code> in the project folder.</p>
  </section>

  <section class="issue-hub">
    <a class="hub-panel" href={`${base}issues/current/`}>
      <span class="strip-label">Now</span>
      <h2>Current issues</h2>
      <p>Active seeds in the float queue — ready to expand.</p>
    </a>
    <a class="hub-panel" href={`${base}issues/future/`}>
      <span class="strip-label">Later</span>
      <h2>Future issues</h2>
      <p>Sharp themes waiting their turn — still yours to claim early.</p>
    </a>
  </section>

  <AddIdea />
</Base>
